# ─── SkySlope OAuth Integration ────────────────────────────────────────────────
# Get these from the SkySlope Developer Portal after registering your app:
# https://developers-books.skyslope.com
#
# Step 1: Register at https://developers-books.skyslope.com
# Step 2: Create a new application — name it "VORO Agent Portal"
# Step 3: Set the Redirect URI to: https://YOUR-RENDER-URL/api/skyslope/callback
# Step 4: Copy the client_id and client_secret below
# Step 5: Add these to Render → Dashboard → Your Service → Environment

SKYSLOPE_CLIENT_ID=your_skyslope_client_id_here
SKYSLOPE_CLIENT_SECRET=your_skyslope_client_secret_here

# Set this to your deployed Render service URL + /api/skyslope/callback
# Example: https://voro-agent-portal.onrender.com/api/skyslope/callback
SKYSLOPE_REDIRECT_URI=https://YOUR-RENDER-URL.onrender.com/api/skyslope/callback

# These are populated AUTOMATICALLY after the OAuth flow completes.
# After your first Connect SkySlope click in Settings → copy the tokens
# from your Render service logs → paste them here as environment variables.
SKYSLOPE_ACCESS_TOKEN=
SKYSLOPE_REFRESH_TOKEN=

# ─── App ────────────────────────────────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_ROLE_GATING_ENABLED=false

# Role simulation for local dev (comma-separated)
# Options: agent, team_lead, commercial_advisor, broker, admin
NEXT_PUBLIC_DEV_ROLES=agent,team_lead
