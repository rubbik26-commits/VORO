# VORO Portal — example env vars. Copy to .env.local and edit as needed.

# ── Auth ────────────────────────────────────────────────────────────────────
# Comma-separated roles the current session will carry.
# Supported: agent,team_lead,commercial_advisor,broker,admin
NEXT_PUBLIC_DEV_ROLES=agent,team_lead

# ── Role gating ─────────────────────────────────────────────────────────────
# When true, middleware.ts restricts /commercial, /recruiting, /revenue-share,
# /teams based on NEXT_PUBLIC_DEV_ROLES. Leave false locally to see everything.
NEXT_PUBLIC_ROLE_GATING_ENABLED=false

# ── Analytics ───────────────────────────────────────────────────────────────
# When true, analytics.track/identify/page calls log to the console.
NEXT_PUBLIC_ANALYTICS_DEBUG=false

# ── Backend (reserved for future) ──────────────────────────────────────────
# NEXT_PUBLIC_API_BASE_URL=https://api.voro.com
# NEXT_PUBLIC_CMS_BASE_URL=https://cms.voro.com
