# ─── SkySlope OAuth Integration ─────────────────────────────────────────────
# Get these from the SkySlope Developer Portal after registering your app:
# https://developers-books.skyslope.com
#
# Step 1: Register at https://developers-books.skyslope.com
# Step 2: Create a new application — name it "VORO Agent Portal"
# Step 3: Set the Redirect URI to:
#           https://YOUR-NETLIFY-SITE.netlify.app/api/skyslope/callback
#         (or your custom domain if you have one)
# Step 4: Copy the Client ID and Client Secret into the values below
# Step 5: Add ALL variables in this file to:
#           Netlify Dashboard → Your Site → Site Configuration → Environment Variables
#         Then trigger a redeploy from Netlify Dashboard → Deploys → Trigger Deploy

SKYSLOPE_CLIENT_ID=your_skyslope_client_id_here
SKYSLOPE_CLIENT_SECRET=your_skyslope_client_secret_here

# Your full Netlify deploy URL + the callback path — must match exactly what
# you registered in the SkySlope Developer Portal.
# Example: https://voro-agent-portal.netlify.app/api/skyslope/callback
SKYSLOPE_REDIRECT_URI=https://YOUR-NETLIFY-SITE.netlify.app/api/skyslope/callback

# These are populated AUTOMATICALLY after the OAuth flow completes the first time.
# After clicking "Connect SkySlope" in Settings:
#   1. Open Netlify Dashboard → Your Site → Logs → Functions
#   2. Click the skyslope-callback log entry
#   3. Copy the access_token and refresh_token values printed there
#   4. Paste them into Netlify → Environment Variables as shown below
#   5. Trigger a redeploy — the portal will immediately start pulling live data
SKYSLOPE_ACCESS_TOKEN=
SKYSLOPE_REFRESH_TOKEN=

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_ROLE_GATING_ENABLED=false

# Role simulation for local dev only (comma-separated)
# Options: agent, team_lead, commercial_advisor, broker, admin
NEXT_PUBLIC_DEV_ROLES=agent,team_lead
